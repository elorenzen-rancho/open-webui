# Copy to .env and fill in your admin API key:
#   cp .env.example .env
#
# ARCADE_API_URL   — Base URL of the open-webui instance
# ARCADE_API_KEY   — Admin API key (Bearer token; Settings → Account → API keys)
# ARCADE_MOCK_DATA — Set to 1 to run entirely on fake data (no API required)

ARCADE_API_URL=https://arcade.rbsprod.net
ARCADE_API_KEY=
ARCADE_MOCK_DATA=0
